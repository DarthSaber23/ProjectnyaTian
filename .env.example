# Root .env for docker compose (variable substitution in docker-compose.yml). Copy to .env and adjust.
# Never commit .env. The API's own settings live in server/.env (see server/.env.example); web never reads it.

# MinIO buckets for independent brands
MINIO_BUCKET_SAMBUNG=tian-sambung-media
MINIO_BUCKET_HALIMUN=tian-halimun-media

# Where nginx (web) reaches MinIO for /media/ reads. Match MINIO_ENDPOINT in server/.env when MinIO
# runs on another host or port. MinIO itself must never be exposed to the internet.
MEDIA_UPSTREAM=http://host.docker.internal:9000

# Host Postgres and MinIO. The API container reaches them through host.docker.internal.
DATABASE_URL=postgresql://tian_app:change-me@host.docker.internal:5432/tian?schema=public
PORT=8080
MINIO_ENDPOINT=http://host.docker.internal:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=tian-media
MINIO_REGION=us-east-1
# Shared staff authenticator secret. Generate with `npm run totp:setup -- --rotate`; never reuse a published example value.
STAFF_TOTP_SECRET=
# Cross-origin callers allowed to use the API with cookies, comma-separated (e.g. a local Vite dev server).
# Leave empty when nginx serves the shop and the API on one origin.
CORS_ORIGINS=

{
  "name": "tian-api",
  "private": true,
  "version": "0.1.0",
  "description": "Indonesian B2C commerce API. Server is the authority for price and stock.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "totp:setup": "node scripts/totp-setup.mjs",
    "media:seed": "node dist/media/cli/seed.js",
    "media:remove-samples": "node dist/media/cli/remove-samples.js",
    "content:seed": "node dist/content/cli/seed.js",
    "content:remove-samples": "node dist/content/cli/remove-samples.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.687.0",
    "@nestjs/common": "10.4.15",
    "@nestjs/core": "10.4.15",
    "@nestjs/platform-express": "10.4.15",
    "@prisma/client": "5.22.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "sharp": "0.33.5"
  },
  "devDependencies": {
    "@types/multer": "1.4.12",
    "@types/node": "22.10.2",
    "prisma": "5.22.0",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}

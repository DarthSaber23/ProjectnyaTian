generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One row per fork. Brand id is configuration (halimun / sambung), not a tenant platform.
model Store {
  id         String      @id
  name       String
  timezone   String      @default("Asia/Jakarta")
  currency   String      @default("IDR")
  categories Category[]
  products   Product[]
  promotions Promotion[]
}

model Category {
  id       String    @id
  storeId  String
  store    Store     @relation(fields: [storeId], references: [id])
  name     String
  slug     String
  products Product[]
}

model Product {
  id         String    @id
  storeId    String
  store      Store     @relation(fields: [storeId], references: [id])
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id])
  slug       String
  name       String
  spec       String?
  tags       String[]
  art        Json
  specs      Json?
  components Json?
  variants   Variant[]
  images     ProductImage[]

  @@unique([storeId, slug])
}

model Variant {
  sku       String        @id
  productId String
  product   Product       @relation(fields: [productId], references: [id])
  label     String
  price     Int
  compareAt Int?
  onHand    Int
  reserved  Int
  attrs     Json?
  imageId   String?
  image     ProductImage? @relation(fields: [imageId], references: [id], onDelete: SetNull)

  @@index([imageId])
}

/// One product photo. Files live in MinIO under media/products/{productId}/{hash16}-{target}.webp.
model ProductImage {
  id           String    @id @default(cuid())
  productId    String
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  position     Int
  alt          String
  hash         String
  width        Int
  height       Int
  sizes        Int[]
  source       String
  creator      String?
  licence      String?
  licenceUrl   String?
  sourceUrl    String?
  retrievedAt  String?
  licenceCheck String?
  createdAt    String
  createdBy    String
  variants     Variant[]

  @@unique([productId, position])
  @@unique([productId, hash])
}

model Promotion {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id])
  code    String
  kind    String
  rule    Json

  @@unique([storeId, code])
}

model OrderSequence {
  id   String @id
  last Int
}

model OrderRecord {
  number     String @id
  storeId    String
  customerId String
  payload    Json
}

model IdempotencyRecord {
  key         String @id
  orderNumber String
}

model CustomerAccount {
  id             String             @id
  name           String
  email          String             @unique
  phone          String
  passwordHash   String
  failedAttempts Int                @default(0)
  lockedUntil    String?
  addresses      AddressRecord[]
  wishlist       WishlistItem[]
  consents       ConsentState?
  consentEvents  ConsentEvent[]
  notifications  NotificationOutbox[]
  reveals        RevealGrant[]
  savedCarts     SavedCart[]
}

model StaffAccount {
  id             String  @id
  name           String
  email          String  @unique
  role           String
  passwordHash   String
  failedAttempts Int     @default(0)
  lockedUntil    String?
}

model SessionToken {
  tokenHash String @id
  kind      String
  subjectId String
  expiresAt String
}

model AuditRecord {
  id     String @id @default(cuid())
  at     String
  actor  String
  code   String
  action String
  object String
  before Json?
  after  Json?
}

model WishlistItem {
  id         String          @id @default(cuid())
  customerId String
  customer   CustomerAccount @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String

  @@unique([customerId, productId])
}

model AddressRecord {
  id         String          @id @default(cuid())
  customerId String
  customer   CustomerAccount @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String?
  recipient  String
  phone      String
  province   String
  city       String
  district   String
  postalCode String
  detail     String
  kelurahan  String?
  note       String?
}

model ConsentState {
  customerId  String          @id
  customer    CustomerAccount @relation(fields: [customerId], references: [id], onDelete: Cascade)
  emailPromo  Boolean         @default(false)
  waOrderInfo Boolean         @default(false)
}

model NotificationOutbox {
  id         String          @id @default(cuid())
  customerId String
  customer   CustomerAccount @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channel    String
  purpose    String
  body       String
  status     String
  createdAt  String
}

model RevealGrant {
  id          String          @id @default(cuid())
  staffId     String
  customerId  String
  customer    CustomerAccount @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderNumber String
  until       String
  reason      String
  at          String
}

model SavedCart {
  id         String          @id
  customerId String
  customer   CustomerAccount @relation(fields: [customerId], references: [id], onDelete: Cascade)
  brand      String
  lines      Json
}

model ConsentEvent {
  id         String          @id @default(cuid())
  customerId String
  customer   CustomerAccount @relation(fields: [customerId], references: [id], onDelete: Cascade)
  key        String
  granted    Boolean
  at         String
  source     String
}

model ContentPage {
  slug   String @id
  title  String
  status String
  blocks Json
}

model PasswordReset {
  id        String @id @default(cuid())
  email     String
  tokenHash String
  expiresAt String
}

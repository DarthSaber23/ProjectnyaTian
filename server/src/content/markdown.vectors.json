[
  { "name": "paragraph", "input": "Halo dunia.", "html": "<p>Halo dunia.</p>" },
  { "name": "lines in one paragraph join with a space", "input": "Baris satu\nbaris dua", "html": "<p>Baris satu baris dua</p>" },
  { "name": "blank line splits paragraphs", "input": "Satu.\n\nDua.", "html": "<p>Satu.</p>\n<p>Dua.</p>" },
  { "name": "h2 and h3", "input": "## Daya\n\n### Panjang", "html": "<h2>Daya</h2>\n<h3>Panjang</h3>" },
  { "name": "h1 stays text", "input": "# Judul", "html": "<p># Judul</p>" },
  { "name": "h4 stays text", "input": "#### Kecil", "html": "<p>#### Kecil</p>" },
  { "name": "bullet list with - and *", "input": "- satu\n* dua", "html": "<ul><li>satu</li><li>dua</li></ul>" },
  { "name": "numbered list", "input": "1. satu\n2. dua", "html": "<ol><li>satu</li><li>dua</li></ol>" },
  { "name": "bold and italic", "input": "**tebal** dan *miring*", "html": "<p><strong>tebal</strong> dan <em>miring</em></p>" },
  { "name": "https link is external", "input": "[Sumber](https://example.com/a?b=1&c=2)", "html": "<p><a href=\"https://example.com/a?b=1&amp;c=2\" rel=\"noopener noreferrer\">Sumber</a></p>" },
  { "name": "site path link", "input": "[Kabel](/produk/kabel-usb-c)", "html": "<p><a href=\"/produk/kabel-usb-c\">Kabel</a></p>" },
  { "name": "javascript link stays text", "input": "[klik](javascript:alert(1))", "html": "<p>[klik](javascript:alert(1))</p>" },
  { "name": "javascript link with spaces stays text", "input": "[klik]( javascript:alert(1) )", "html": "<p>[klik]( javascript:alert(1) )</p>" },
  { "name": "data url stays text", "input": "[x](data:text/html;base64,PHNjcmlwdD4=)", "html": "<p>[x](data:text/html;base64,PHNjcmlwdD4=)</p>" },
  { "name": "protocol-relative link stays text", "input": "[x](//evil.example)", "html": "<p>[x](//evil.example)</p>" },
  { "name": "script tag is escaped", "input": "<script>alert(1)</script>", "html": "<p>&lt;script&gt;alert(1)&lt;/script&gt;</p>" },
  { "name": "raw html with onerror is escaped", "input": "<img src=x onerror=alert(1)>", "html": "<p>&lt;img src=x onerror=alert(1)&gt;</p>" },
  { "name": "raw bold tag is escaped", "input": "<b>tebal</b>", "html": "<p>&lt;b&gt;tebal&lt;/b&gt;</p>" },
  { "name": "quotes and ampersand are escaped", "input": "\"A\" & 'B'", "html": "<p>&quot;A&quot; &amp; &#39;B&#39;</p>" },
  { "name": "quote cannot break out of href", "input": "[x](https://a.example/\"onmouseover=\"alert(1))", "html": "<p>[x](https://a.example/&quot;onmouseover=&quot;alert(1))</p>" },
  { "name": "article image line", "input": "![Kabel putih](/media/articles/art1/0123456789abcdef-960.webp)", "html": "<figure><img src=\"/media/articles/art1/0123456789abcdef-960.webp\" alt=\"Kabel putih\" loading=\"lazy\" decoding=\"async\"></figure>" },
  { "name": "image from elsewhere stays text", "input": "![x](https://evil.example/a.png)", "html": "<p>![x](https://evil.example/a.png)</p>" },
  { "name": "image alt is escaped", "input": "![a\"b<c](/media/articles/art1/0123456789abcdef-960.webp)", "html": "<figure><img src=\"/media/articles/art1/0123456789abcdef-960.webp\" alt=\"a&quot;b&lt;c\" loading=\"lazy\" decoding=\"async\"></figure>" },
  { "name": "nested brackets are not a link", "input": "[[x]](https://a.example)", "html": "<p>[[x]](https://a.example)</p>" },
  { "name": "bold inside a link", "input": "[**Kabel**](/produk/a)", "html": "<p><a href=\"/produk/a\"><strong>Kabel</strong></a></p>" },
  { "name": "empty input", "input": "", "html": "" },
  { "name": "windows line endings", "input": "## A\r\n\r\nB", "html": "<h2>A</h2>\n<p>B</p>" }
